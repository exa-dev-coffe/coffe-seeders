# ==============================================================================
# Coffe Seeders - Environment Variables Template
# All production secrets are configured in GitHub Actions Secrets:
# https://github.com/exa-dev-coffe/coffe-seeders/settings/secrets/actions
# ==============================================================================

# Database URLs (Direct Postgres Connections)
DB_MASTER_URL=postgres://user:password@localhost:5432/db_master_data?sslmode=disable
DB_TX_URL=postgres://user:password@localhost:5432/transaction?sslmode=disable
DB_WALLET_URL=postgres://user:password@localhost:5432/wallet?sslmode=disable

# API Endpoints (Kong Gateway or Direct Services)
API_URL=http://localhost:8000
MASTER_DATA_URL=http://localhost:8000
TRANSACTION_URL=http://localhost:8000
AUTH_URL=http://localhost:8000

# Authentication Secret (HS512)
SECRET_JWT=your_jwt_secret_key_here
APP_JWT_SECRET=your_jwt_secret_key_here

# Customer Default Security PIN Hash (Bcrypt)
CUSTOMER_DEFAULT_PIN_HASH=your_bcrypt_hash_here
